<UserControl
    x:Class="v2rayN.Desktop.Views.ConnectionRulesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:ConnectionRulesViewModel">
    <!--  The editor fills the height; the side column scrolls on its own.  -->
    <Grid Margin="28,20,12,12" ColumnDefinitions="*,20,340" RowDefinitions="Auto,*">
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,16,4">
            <TextBlock Classes="title" Text="{x:Static resx:AppText.RulesTitle}" />
            <TextBlock Classes="subtitle" Text="{x:Static resx:AppText.RulesSubtitle}" />
        </StackPanel>

        <DockPanel Grid.Row="1">
            <Border Classes="card" DockPanel.Dock="Top">
                <DockPanel>
                    <ComboBox
                        MinWidth="170"
                        VerticalAlignment="Center"
                        DisplayMemberBinding="{ReflectionBinding Value}"
                        DockPanel.Dock="Right"
                        ItemsSource="{Binding OverrideModes}"
                        SelectedValue="{Binding OverrideMode}"
                        SelectedValueBinding="{ReflectionBinding Key}" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Classes="head" Text="{x:Static resx:AppText.RulesOverride}" />
                        <TextBlock Classes="hint" Text="{x:Static resx:AppText.RulesOverrideHint}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border
                Classes="warn"
                DockPanel.Dock="Top"
                IsVisible="{Binding FallbackText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Classes="body" Text="{Binding FallbackText}" />
            </Border>

            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock
                    Margin="0,8,0,0"
                    Classes="body"
                    Foreground="{DynamicResource SemiColorDanger}"
                    IsVisible="{Binding HasErrors}"
                    Text="{Binding StatusText}" />
                <TextBlock
                    Margin="0,8,0,0"
                    Classes="body"
                    Foreground="{DynamicResource SemiColorSuccess}"
                    IsVisible="{Binding !HasErrors}"
                    Text="{Binding StatusText}" />
                <StackPanel Margin="0,10,0,0" Classes="row">
                    <Button
                        Classes="Primary"
                        Command="{Binding SaveCmd}"
                        Content="{x:Static resx:AppText.RulesSave}"
                        Theme="{DynamicResource SolidButton}" />
                    <Button Command="{Binding RevertCmd}" Content="{x:Static resx:AppText.RulesRevert}" IsEnabled="{Binding IsDirty}" />
                </StackPanel>
            </StackPanel>

            <TextBox
                AcceptsReturn="True"
                FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono, monospace"
                FontSize="13"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                Text="{Binding RulesText}"
                TextWrapping="NoWrap"
                VerticalContentAlignment="Top" />
        </DockPanel>

        <ScrollViewer
            Grid.Row="1"
            Grid.Column="2"
            Padding="0,0,12,0"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Classes="head" Text="{x:Static resx:AppText.RulesProfile}" />
                <TextBlock Classes="hint" Text="{x:Static resx:AppText.RulesProfileHint}" />
                <Grid Margin="0,0,0,6" ColumnDefinitions="*,Auto,Auto">
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" />
                    <Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Command="{Binding LoadProfileCmd}"
                        Content="{x:Static resx:AppText.RulesProfileLoad}" />
                    <Button
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Command="{Binding DeleteProfileCmd}"
                        Content="✕"
                        ToolTip.Tip="{x:Static resx:AppText.RulesProfileDelete}" />
                </Grid>
                <Grid Margin="0,0,0,18" ColumnDefinitions="*,Auto">
                    <TextBox PlaceholderText="{x:Static resx:AppText.RulesProfileNamePlaceholder}" Text="{Binding NewProfileName}" />
                    <Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Command="{Binding SaveProfileCmd}"
                        Content="{x:Static resx:AppText.RulesProfileSave}" />
                </Grid>

                <TextBlock Classes="head" Text="{x:Static resx:AppText.RulesPresets}" />
                <TextBlock Classes="hint" Text="{x:Static resx:AppText.RulesPresetsHint}" />
                <ItemsControl x:Name="presets" Margin="-3,0" ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vms:PresetCardModel">
                            <Border
                                Margin="3"
                                Padding="10,6,4,6"
                                Classes="card"
                                ToolTip.Tip="{Binding Why}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="{Binding Mode}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        Command="{Binding #presets.((vms:ConnectionRulesViewModel)DataContext).AddPresetCmd}"
                                        CommandParameter="{Binding Line}"
                                        Content="+"
                                        ToolTip.Tip="{x:Static resx:AppText.RulesAddPreset}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel>
                    <TextBlock Margin="0,18,0,0" Classes="head" Text="{x:Static resx:AppText.RulesLearnTitle}" />
                    <TextBlock Classes="hint" Text="{x:Static resx:AppText.RulesLearnHint}" />
                    <StackPanel Classes="row">
                        <Button Command="{Binding LearnCmd}" Content="{x:Static resx:AppText.RulesLearnStart}" />
                        <ProgressBar
                            Width="18"
                            Height="18"
                            IsIndeterminate="True"
                            IsVisible="{Binding IsLearning}"
                            Theme="{DynamicResource ProgressRing}" />
                    </StackPanel>
                </StackPanel>

                <Expander Margin="0,18,0,8" HorizontalAlignment="Stretch" Header="{x:Static resx:AppText.RulesSyntaxTitle}">
                    <TextBlock
                        FontFamily="Cascadia Mono, Menlo, DejaVu Sans Mono, monospace"
                        FontSize="11"
                        Foreground="{DynamicResource SemiColorText2}"
                        Text="{x:Static resx:AppText.RulesSyntax}"
                        TextWrapping="Wrap" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
