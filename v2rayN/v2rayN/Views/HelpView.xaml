<UserControl
    x:Class="v2rayN.Views.HelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="32,24,32,24">
            <ui:TextBlock FontTypography="Title" Text="{x:Static resx:HelpContent.Title}" />
            <ui:TextBlock
                Margin="0,6,0,20"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resx:HelpContent.Subtitle}"
                TextWrapping="Wrap" />

            <ui:Card Margin="0,0,0,16" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontFamily="{DynamicResource DetourMonoFont}"
                            FontSize="11"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.UpdateHeader}" />
                        <TextBlock x:Name="txtVersion" Margin="0,2,0,0" FontFamily="{DynamicResource DetourMonoFont}" />
                        <TextBlock
                            x:Name="txtUpdateStatus"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ui:Button
                        Grid.Column="1"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Click="BtnBlockMap_Click"
                        Content="{x:Static resx:AppText.BlockMapButton}" />
                    <ui:Button
                        x:Name="btnDiagnostics"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Click="BtnDiagnostics_Click"
                        Content="{x:Static resx:AppText.DiagButton}" />
                    <ui:Button
                        x:Name="btnUpdate"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Appearance="Primary"
                        Click="BtnUpdate_Click"
                        Content="{x:Static resx:AppText.UpdateCheck}" />
                </Grid>
            </ui:Card>

            <ItemsControl ItemsSource="{x:Static resx:HelpContent.Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:CardExpander
                            Margin="0,0,0,6"
                            Header="{Binding Title}"
                            IsExpanded="{Binding Expanded, Mode=OneTime}">
                            <TextBlock
                                LineHeight="22"
                                Text="{Binding Body}"
                                TextWrapping="Wrap" />
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
