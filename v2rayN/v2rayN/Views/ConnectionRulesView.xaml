<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.ConnectionRulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    x:TypeArguments="vms:ConnectionRulesViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:NotEmptyToBoolConverter x:Key="NotEmpty" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SideCaption" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!--  The page itself does not scroll: the editor fills the height, the side column scrolls on its own.  -->
    <Grid Margin="32,24,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,16,16">
            <ui:TextBlock FontTypography="Title" Text="{x:Static resx:AppText.RulesTitle}" />
            <ui:TextBlock
                Margin="0,6,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resx:AppText.RulesSubtitle}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Left: mode switch, editor (fills the height), actions  -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <ui:CardControl
                Margin="0,0,0,12"
                DockPanel.Dock="Top"
                Icon="{ui:SymbolIcon ArrowSwap24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resx:AppText.RulesOverride}" />
                        <TextBlock
                            Margin="0,2,24,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.RulesOverrideHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox
                    MinWidth="170"
                    DisplayMemberPath="Value"
                    ItemsSource="{Binding OverrideModes}"
                    SelectedValue="{Binding OverrideMode}"
                    SelectedValuePath="Key" />
            </ui:CardControl>

            <ui:InfoBar
                Margin="0,0,0,12"
                DockPanel.Dock="Top"
                IsClosable="False"
                IsOpen="{Binding FallbackText, Converter={StaticResource NotEmpty}}"
                Message="{Binding FallbackText}"
                Severity="Warning" />

            <StackPanel DockPanel.Dock="Bottom">
                <ui:InfoBar
                    Margin="0,12,0,0"
                    IsClosable="True"
                    IsOpen="{Binding StatusText, Converter={StaticResource NotEmpty}, Mode=OneWay}"
                    Message="{Binding StatusText}">
                    <ui:InfoBar.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:InfoBar}}" TargetType="ui:InfoBar">
                            <Setter Property="Severity" Value="Success" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                    <Setter Property="Severity" Value="Error" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:InfoBar.Style>
                </ui:InfoBar>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding SaveCmd}"
                        Content="{x:Static resx:AppText.RulesSave}"
                        Icon="{ui:SymbolIcon Checkmark24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding RevertCmd}"
                        Content="{x:Static resx:AppText.RulesRevert}"
                        IsEnabled="{Binding IsDirty}" />
                </StackPanel>
            </StackPanel>

            <Border
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <TextBox
                    x:Name="txtRules"
                    Padding="14,12"
                    VerticalContentAlignment="Top"
                    AcceptsReturn="True"
                    AcceptsTab="False"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="13"
                    HorizontalScrollBarVisibility="Auto"
                    SpellCheck.IsEnabled="False"
                    Text="{Binding RulesText, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </Border>
        </DockPanel>

        <!--  Right: its own scroll  -->
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="2"
            Padding="0,0,12,0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!--  Block check: what works without VPN, suggested rules  -->
                <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static resx:AppText.CheckTitle}" />
                <TextBlock Style="{StaticResource SideCaption}" Text="{x:Static resx:AppText.CheckHint}" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding CheckBlocksCmd}"
                        Content="{x:Static resx:AppText.CheckRun}"
                        Icon="{ui:SymbolIcon ShieldTask24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding ApplyCheckCmd}"
                        Content="{x:Static resx:AppText.CheckApply}"
                        Visibility="{Binding HasCheckResults, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock
                    Margin="0,8,0,0"
                    FontFamily="Cascadia Mono, Consolas"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding CheckStatus}"
                    Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding CheckRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,6"
                                Padding="10,6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                ToolTip="{Binding Verdict}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock
                                        FontFamily="Cascadia Mono, Consolas"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Paths}" />
                                    <TextBlock FontSize="12" Text="{Binding Suggestion}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Domain lists  -->
                <ui:TextBlock
                    Margin="0,14,0,0"
                    FontTypography="BodyStrong"
                    Text="{x:Static resx:AppText.ListsTitle}" />
                <TextBlock Style="{StaticResource SideCaption}" Text="{Binding ListsText}" />
                <ui:Button
                    Margin="0,0,0,20"
                    Command="{Binding UpdateListsCmd}"
                    Content="{x:Static resx:AppText.ListsUpdate}"
                    Icon="{ui:SymbolIcon ArrowSync24}" />

                <!--  Profiles  -->
                <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static resx:AppText.RulesProfile}" />
                <TextBlock Style="{StaticResource SideCaption}" Text="{x:Static resx:AppText.RulesProfileHint}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Command="{Binding LoadProfileCmd}"
                        Content="{x:Static resx:AppText.RulesProfileLoad}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="6,0,0,0"
                        Appearance="Transparent"
                        Command="{Binding DeleteProfileCmd}"
                        Icon="{ui:SymbolIcon Delete24}"
                        ToolTip="{x:Static resx:AppText.RulesProfileDelete}" />
                </Grid>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox PlaceholderText="{x:Static resx:AppText.RulesProfileNamePlaceholder}" Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Command="{Binding SaveProfileCmd}"
                        Icon="{ui:SymbolIcon Save24}"
                        ToolTip="{x:Static resx:AppText.RulesProfileSave}" />
                </Grid>

                <!--  Presets: compact two-column tiles, the explanation is in the tooltip  -->
                <ui:TextBlock FontTypography="BodyStrong" Text="{x:Static resx:AppText.RulesPresets}" />
                <TextBlock Style="{StaticResource SideCaption}" Text="{x:Static resx:AppText.RulesPresetsHint}" />
                <ItemsControl Margin="-3,0" ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="3"
                                Padding="10,6,4,6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                ToolTip="{Binding Why}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Mode}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.AddPresetCmd, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Line}"
                                        Icon="{ui:SymbolIcon Add16}"
                                        ToolTip="{x:Static resx:AppText.RulesAddPreset}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  Learning mode  -->
                <ui:TextBlock
                    Margin="0,20,0,0"
                    FontTypography="BodyStrong"
                    Text="{x:Static resx:AppText.RulesLearnTitle}" />
                <TextBlock Style="{StaticResource SideCaption}" Text="{x:Static resx:AppText.RulesLearnHint}" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding LearnCmd}"
                        Content="{x:Static resx:AppText.RulesLearnStart}"
                        Icon="{ui:SymbolIcon Record24}" />
                    <ui:ProgressRing
                        Width="20"
                        Height="20"
                        Margin="12,0,0,0"
                        IsIndeterminate="True"
                        Visibility="{Binding IsLearning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <ui:CardExpander
                    Margin="0,20,0,8"
                    Header="{x:Static resx:AppText.RulesSyntaxTitle}"
                    Icon="{ui:SymbolIcon QuestionCircle24}">
                    <TextBlock
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="11"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{x:Static resx:AppText.RulesSyntax}"
                        TextWrapping="Wrap" />
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</reactiveui:ReactiveUserControl>
