<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.WarpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="700"
    d:DesignWidth="900"
    x:TypeArguments="vms:WarpViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="32,24,32,24">
            <ui:TextBlock FontTypography="Title" Text="{x:Static resx:AppText.WarpTitle}" />
            <ui:TextBlock
                Margin="0,6,0,20"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resx:AppText.WarpSubtitle}"
                TextWrapping="Wrap" />

            <!--  Status  -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon WeatherCloudy24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding StateText}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding DeviceText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding StartCmd}"
                        Content="{x:Static resx:AppText.TgStart}"
                        Icon="{ui:SymbolIcon Play24}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ui:Button
                        Command="{Binding StopCmd}"
                        Content="{x:Static resx:AppText.TgStop}"
                        Icon="{ui:SymbolIcon Stop24}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding TestCmd}"
                        Content="{x:Static resx:AppText.WarpTest}"
                        Icon="{ui:SymbolIcon Pulse24}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl
                Margin="0,0,0,4"
                Header="{x:Static resx:AppText.WarpEnabled}"
                Icon="{ui:SymbolIcon Power24}">
                <ui:ToggleSwitch IsChecked="{Binding Enabled}" />
            </ui:CardControl>

            <!--  Registration  -->
            <ui:CardControl Margin="0,16,0,4" Icon="{ui:SymbolIcon Key24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resx:AppText.WarpRegister}" />
                        <TextBlock
                            Margin="0,2,24,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.WarpRegisterHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Command="{Binding RegisterCmd}" Icon="{ui:SymbolIcon PersonAdd24}">
                    <ui:Button.Style>
                        <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                            <Setter Property="Content" Value="{x:Static resx:AppText.WarpReRegister}" />
                            <Setter Property="Appearance" Value="Secondary" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegistered}" Value="False">
                                    <Setter Property="Content" Value="{x:Static resx:AppText.WarpRegister}" />
                                    <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </ui:CardControl>

            <!--  Noise  -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon ShieldLock24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resx:AppText.WarpNoise}" />
                        <TextBlock
                            Margin="0,2,24,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.WarpNoiseHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding Noise}" />
            </ui:CardControl>

            <!--  Endpoint  -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Globe24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resx:AppText.WarpEndpoint}" />
                        <TextBlock
                            Margin="0,2,24,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.WarpEndpointHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ComboBox
                        MinWidth="180"
                        IsEditable="True"
                        ItemsSource="{Binding Endpoints}"
                        Text="{Binding EndpointText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding ApplyEndpointCmd}"
                        Content="OK" />
                </StackPanel>
            </ui:CardControl>

            <!--  Port  -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon NumberSymbol24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resx:AppText.TgPort}" />
                        <TextBlock
                            Margin="0,2,24,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.WarpPortHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox MinWidth="100" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding ApplyPortCmd}"
                        Content="OK" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding OpenLogCmd}"
                        Content="{x:Static resx:AppText.TgOpenLog}"
                        Icon="{ui:SymbolIcon DocumentText24}" />
                </StackPanel>
            </ui:CardControl>

            <ui:InfoBar
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Static resx:AppText.WarpRulesNote}"
                Severity="Informational" />

            <!--  Progress  -->
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,10,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ProgressText}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
