<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.TgWsProxyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="700"
    d:DesignWidth="900"
    x:TypeArguments="vms:TgWsProxyViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="32,24,32,24">
            <ui:TextBlock FontTypography="Title" Text="{x:Static resx:AppText.TgTitle}" />
            <ui:TextBlock
                Margin="0,6,0,20"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{x:Static resx:AppText.TgSubtitle}"
                TextWrapping="Wrap" />

            <!--  Status  -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Send24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding StateText}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding VersionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Command="{Binding InstallCmd}" Icon="{ui:SymbolIcon ArrowDownload24}">
                        <ui:Button.Style>
                            <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                <Setter Property="Content" Value="{x:Static resx:AppText.TgUpdate}" />
                                <Setter Property="Appearance" Value="Secondary" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                        <Setter Property="Content" Value="{x:Static resx:AppText.TgInstall}" />
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Command="{Binding StartCmd}"
                        Content="{x:Static resx:AppText.TgStart}"
                        Icon="{ui:SymbolIcon Play24}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding StopCmd}"
                        Content="{x:Static resx:AppText.TgStop}"
                        Icon="{ui:SymbolIcon Stop24}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl
                Margin="0,0,0,4"
                Header="{x:Static resx:AppText.TgEnabled}"
                Icon="{ui:SymbolIcon Power24}">
                <ui:ToggleSwitch IsChecked="{Binding Enabled}" />
            </ui:CardControl>

            <!--  Connect Telegram  -->
            <ui:CardControl Margin="0,16,0,4" Icon="{ui:SymbolIcon Link24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resx:AppText.TgConnect}" />
                        <TextBlock
                            Margin="0,2,24,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.TgConnectHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding ConnectTelegramCmd}"
                        Content="{x:Static resx:AppText.TgConnect}"
                        Icon="{ui:SymbolIcon Send24}" />
                    <ui:Button
                        x:Name="btnCopyLink"
                        Margin="8,0,0,0"
                        Content="{x:Static resx:AppText.TgCopyLink}"
                        Icon="{ui:SymbolIcon Copy24}" />
                </StackPanel>
            </ui:CardControl>

            <!--  Port  -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon NumberSymbol24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resx:AppText.TgPort}" />
                        <TextBlock
                            Margin="0,2,24,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.TgPortHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox MinWidth="100" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding ApplyPortCmd}"
                        Content="OK" />
                </StackPanel>
            </ui:CardControl>

            <!--  Secret  -->
            <ui:CardControl Margin="0,0,0,4" Icon="{ui:SymbolIcon Key24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{x:Static resx:AppText.TgNewSecret}" />
                        <TextBlock
                            Margin="0,2,24,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{x:Static resx:AppText.TgNewSecretHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Command="{Binding NewSecretCmd}"
                        Content="{x:Static resx:AppText.TgNewSecret}"
                        Icon="{ui:SymbolIcon ArrowSync24}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Command="{Binding OpenLogCmd}"
                        Content="{x:Static resx:AppText.TgOpenLog}"
                        Icon="{ui:SymbolIcon DocumentText24}" />
                </StackPanel>
            </ui:CardControl>

            <ui:InfoBar
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Static resx:AppText.TgRoutingNote}"
                Severity="Informational" />

            <ui:InfoBar
                Margin="0,8,0,0"
                IsClosable="False"
                IsOpen="{Binding StandaloneSecretDiffers}"
                Message="{x:Static resx:AppText.TgStandaloneDiffers}"
                Severity="Warning">
                <ui:InfoBar.Content>
                    <ui:Button
                        Margin="0,0,0,8"
                        Command="{Binding UseStandaloneSecretCmd}"
                        Content="{x:Static resx:AppText.TgUseStandaloneSecret}"
                        Icon="{ui:SymbolIcon Key24}" />
                </ui:InfoBar.Content>
            </ui:InfoBar>

            <!--  Progress  -->
            <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    Margin="0,0,10,0"
                    IsIndeterminate="True"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ProgressText}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock
                Margin="0,24,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="{x:Static resx:AppText.ZapretSource}" /><Run Text=": github.com/Flowseal/tg-ws-proxy (MIT)" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</reactiveui:ReactiveUserControl>
