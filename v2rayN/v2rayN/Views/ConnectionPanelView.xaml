<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.ConnectionPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:v2rayN.Controls"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:TypeArguments="vms:ConnectionPanelViewModel">
    <UserControl.Resources>
        <conv:InvertBoolConverter x:Key="Inverse" />
        <conv:NotEmptyToBoolConverter x:Key="NotEmpty" />

        <!--  Accent while connected, idle grey otherwise.  -->
        <Style x:Key="StateFill" TargetType="Rectangle">
            <Setter Property="Fill" Value="{DynamicResource DetourIdleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource DetourAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Readout" BasedOn="{StaticResource DetourMono}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource DetourPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ===== Header strip: status + mode =====  -->
                <Border
                    Padding="14,0,8,0"
                    Background="{DynamicResource DetourPanelHeaderBrush}"
                    BorderBrush="{DynamicResource DetourLineBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="4,4,0,0">
                    <Grid Height="36">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Rectangle
                                Width="8"
                                Height="8"
                                Margin="0,0,10,0"
                                Style="{StaticResource StateFill}" />
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DetourLabel}"
                                Text="{x:Static resx:AppText.PanelStatus}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource DetourMono}" TargetType="TextBlock">
                                        <Setter Property="Text" Value="{x:Static resx:AppText.PanelOffline}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="{x:Static resx:AppText.PanelOnline}" />
                                                <Setter Property="Foreground" Value="{DynamicResource DetourAccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            ToolTip="{x:Static resx:AppText.ConnModeHint}">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DetourLabel}"
                                Text="{x:Static resx:AppText.PanelMode}" />
                            <Border
                                Padding="2"
                                BorderBrush="{DynamicResource DetourLineBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        Content="TUN"
                                        GroupName="connMode"
                                        IsChecked="{Binding UseTun}"
                                        Style="{StaticResource DetourSegment}"
                                        ToolTip="{x:Static resx:AppText.ConnModeTun}" />
                                    <RadioButton
                                        Content="PROXY"
                                        GroupName="connMode"
                                        IsChecked="{Binding UseTun, Converter={StaticResource Inverse}}"
                                        Style="{StaticResource DetourSegment}"
                                        ToolTip="{x:Static resx:AppText.ConnModeProxy}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ===== Body: readouts | graph | button =====  -->
                <Grid Grid.Row="1" Margin="16,14,16,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource DetourLabel}" Text="{x:Static resx:AppText.PanelServer}" />
                        <TextBlock
                            MaxWidth="320"
                            Margin="0,3,0,0"
                            HorizontalAlignment="Left"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="{Binding ServerName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding StatusDetail}" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="92" />
                                <ColumnDefinition Width="Auto" MinWidth="96" />
                                <ColumnDefinition Width="Auto" MinWidth="96" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DetourLabel}" Text="{x:Static resx:AppText.PanelUptime}" />
                                <TextBlock Style="{StaticResource Readout}" Text="{Binding UptimeText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource DetourLabel}" Text="{x:Static resx:AppText.PanelDown}" />
                                <TextBlock
                                    Foreground="{DynamicResource DetourAccentBrush}"
                                    Style="{StaticResource Readout}"
                                    Text="{Binding DownText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource DetourLabel}" Text="{x:Static resx:AppText.PanelUp}" />
                                <TextBlock Style="{StaticResource Readout}" Text="{Binding UpText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!--  Traffic graph  -->
                    <Grid Grid.Column="1" Margin="20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Style="{StaticResource DetourLabel}" Text="{x:Static resx:AppText.PanelTraffic}" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DetourLabel}" Text="{x:Static resx:AppText.PanelDirect}" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource DetourMono}"
                                    Text="{Binding DirectText}" />
                            </StackPanel>
                        </Grid>
                        <Border
                            Grid.Row="1"
                            Height="74"
                            Margin="0,6,0,0"
                            BorderBrush="{DynamicResource DetourLineBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                            <controls:TrafficGraph
                                Margin="1"
                                Down="{Binding DownHistory}"
                                DownBrush="{DynamicResource DetourAccentBrush}"
                                DownFill="{DynamicResource DetourAccentSoftBrush}"
                                GridBrush="{DynamicResource DetourGridBrush}"
                                Up="{Binding UpHistory}"
                                UpBrush="{DynamicResource TextFillColorTertiaryBrush}" />
                        </Border>
                        <!--  Past the VPN today (direct + zapret): the subscription's savings  -->
                        <TextBlock
                            Grid.Row="2"
                            Margin="0,6,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource DetourMono}"
                            Text="{Binding SavingsText}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding SavingsDetail}" />
                        <!--  Provider's traffic / expiry for the current server's subscription  -->
                        <TextBlock
                            Grid.Row="3"
                            Margin="0,2,0,0"
                            FontSize="10.5"
                            Text="{Binding SubInfoText}"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style BasedOn="{StaticResource DetourMono}" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SubInfoWarning}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DetourWarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleCmd}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource DetourConnectButton}" TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                FontSize="18"
                                Symbol="Power24" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding ButtonText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <ui:InfoBar
            Margin="0,8,0,0"
            IsClosable="True"
            IsOpen="{Binding ConflictText, Converter={StaticResource NotEmpty}, Mode=OneWay}"
            Message="{Binding ConflictText}"
            Severity="Warning" />

        <ui:InfoBar
            Margin="0,8,0,0"
            IsClosable="False"
            IsOpen="{Binding GameText, Converter={StaticResource NotEmpty}, Mode=OneWay}"
            Message="{Binding GameText}"
            Severity="Informational" />

        <!--  Rules with a server list ("= A; B"): the server each one is on now  -->
        <TextBlock
            Margin="2,8,0,0"
            FontSize="10.5"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{Binding RuleServersText}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style BasedOn="{StaticResource DetourMono}" TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RuleServersText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ui:InfoBar
            Margin="0,8,0,0"
            IsClosable="False"
            IsOpen="{Binding KillSwitchEngaged}"
            Message="{x:Static resx:AppText.KillSwitchEngaged}"
            Severity="Error">
            <ui:InfoBar.Content>
                <ui:Button
                    Margin="0,6,0,0"
                    Command="{Binding UnblockCmd}"
                    Content="{x:Static resx:AppText.KillSwitchUnblock}" />
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <!--  ===== Options strip =====  -->
        <Border
            Margin="0,8,0,0"
            Padding="12,6"
            Style="{StaticResource DetourPanel}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock
                        MaxWidth="360"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Text="{Binding IpCheckText}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding IpCheckText}">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource DetourMono}" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IpCheckWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource DetourWarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ui:Button
                        Padding="10,4"
                        Appearance="Secondary"
                        Command="{Binding CheckIpCmd}"
                        Content="{x:Static resx:AppText.IpCheck}"
                        Icon="{ui:SymbolIcon Globe24}" />
                </StackPanel>

                <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel
                        Margin="0,0,20,0"
                        Orientation="Horizontal"
                        ToolTip="{x:Static resx:AppText.KillSwitchHint}">
                        <ui:ToggleSwitch IsChecked="{Binding KillSwitchEnabled}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:AppText.KillSwitch}" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,0,20,0"
                        Orientation="Horizontal"
                        ToolTip="{x:Static resx:AppText.AutoFailoverHint}">
                        <ui:ToggleSwitch IsChecked="{Binding AutoFailover}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:AppText.AutoFailover}" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,0,20,0"
                        Orientation="Horizontal"
                        ToolTip="{x:Static resx:AppText.GameModeHint}">
                        <ui:ToggleSwitch IsChecked="{Binding GameMode}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:AppText.GameMode}" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,0,20,0"
                        Orientation="Horizontal"
                        ToolTip="{x:Static resx:AppText.ResumeReconnectHint}">
                        <ui:ToggleSwitch IsChecked="{Binding ResumeReconnect}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:AppText.ResumeReconnect}" />
                    </StackPanel>
                    <StackPanel
                        Margin="0,0,20,0"
                        Orientation="Horizontal"
                        ToolTip="{x:Static resx:AppText.ConnectOnStartupHint}">
                        <ui:ToggleSwitch IsChecked="{Binding ConnectOnStartup}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:AppText.ConnectOnStartup}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{x:Static resx:AppText.AutoRunWindowsHint}">
                        <ui:ToggleSwitch IsChecked="{Binding AutoRun}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="{x:Static resx:AppText.AutoRunWindows}" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!--  ===== Tools: the checks that used to hide in Help / Diagnostics =====  -->
        <Border
            Margin="0,8,0,0"
            Padding="12,8"
            Style="{StaticResource DetourPanel}">
            <DockPanel>
                <TextBlock
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Style="{StaticResource DetourLabel}"
                    Text="{x:Static resx:AppText.ToolsTitle}" />
                <WrapPanel Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Appearance="Secondary"
                        Click="BtnSiteCheck_Click"
                        Content="{x:Static resx:AppText.SiteTitle}"
                        Icon="{ui:SymbolIcon GlobeSearch24}"
                        ToolTip="{x:Static resx:AppText.SiteHint}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Appearance="Secondary"
                        Click="BtnBlockCheck_Click"
                        Content="{x:Static resx:AppText.CheckTitle}"
                        Icon="{ui:SymbolIcon ShieldTask24}"
                        ToolTip="{x:Static resx:AppText.CheckHint}" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Padding="10,4"
                        Appearance="Secondary"
                        Click="BtnDiagnostics_Click"
                        Content="{x:Static resx:AppText.ToolsDiagnostics}"
                        Icon="{ui:SymbolIcon Stethoscope24}" />
                    <ui:Button
                        Padding="10,4"
                        Appearance="Secondary"
                        Click="BtnBlockMap_Click"
                        Content="{x:Static resx:AppText.BlockMapButton}"
                        Icon="{ui:SymbolIcon Map24}" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</reactiveui:ReactiveUserControl>
