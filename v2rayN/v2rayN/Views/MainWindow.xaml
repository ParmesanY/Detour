<base:WindowBase
    x:Class="v2rayN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="Detour"
    Width="1200"
    Height="800"
    MinWidth="900"
    MinHeight="560"
    x:TypeArguments="vms:MainWindowViewModel"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Icon="/Resources/app.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

            <!--  Sidebar item: subtle fill on hover, accent pill on the selected one (Windows 11 style).  -->
            <Style x:Key="NavItem" TargetType="RadioButton">
                <Setter Property="GroupName" Value="nav" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border
                                    x:Name="bg"
                                    Background="Transparent"
                                    CornerRadius="4" />
                                <Border
                                    x:Name="pill"
                                    Width="2"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource DetourAccentBrush}"
                                    Visibility="Hidden" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter TargetName="pill" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavSection" BasedOn="{StaticResource DetourLabel}" TargetType="TextBlock">
                <Setter Property="Margin" Value="14,14,0,6" />
            </Style>

            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bg"
                                Background="Transparent"
                                CornerRadius="5">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavIcon" TargetType="ui:SymbolIcon">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Margin" Value="0,0,12,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:DialogHost
        materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ============ Sidebar ============  -->
            <DockPanel Grid.Column="0" Margin="8,12,8,10">
                <Grid Margin="12,6,0,10" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="30"
                        Height="30"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="/Resources/logo.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="txtAppName"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Style="{StaticResource DetourMono}"
                            Text="DETOUR" />
                        <TextBlock
                            x:Name="txtAppSubtitle"
                            Margin="0,1,0,0"
                            Style="{StaticResource DetourLabel}" />
                    </StackPanel>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom">
                    <ui:Button
                        x:Name="btnNewUpdate"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Stretch"
                        Appearance="Info"
                        Content="{x:Static resx:ResUI.menuNewUpdate}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Visibility="Hidden" />

                    <Button x:Name="btnAppearance" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="DarkTheme24" />
                            <TextBlock Text="{x:Static resx:AppText.NavAppearance}" />
                        </StackPanel>
                    </Button>
                    <Popup
                        x:Name="popAppearance"
                        AllowsTransparency="True"
                        Placement="Right"
                        PlacementTarget="{Binding ElementName=btnAppearance}"
                        StaysOpen="False">
                        <Border
                            Padding="12"
                            Background="{DynamicResource ApplicationBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentControl x:Name="pbTheme" />
                        </Border>
                    </Popup>

                    <Button x:Name="btnSettings" Style="{StaticResource NavButton}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Settings24" />
                            <TextBlock Text="{x:Static resx:AppText.NavSettings}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Top">
                                <MenuItem x:Name="menuOptionSetting" Header="{x:Static resx:ResUI.menuOptionSetting}" />
                                <MenuItem x:Name="menuRoutingSetting" Header="{x:Static resx:ResUI.menuRoutingSetting}" />
                                <MenuItem x:Name="menuDNSSetting" Header="{x:Static resx:ResUI.menuDNSSetting}" />
                                <MenuItem x:Name="menuFullConfigTemplate" Header="{x:Static resx:ResUI.menuFullConfigTemplate}" />
                                <MenuItem x:Name="menuGlobalHotkeySetting" Header="{x:Static resx:ResUI.menuGlobalHotkeySetting}" />
                                <Separator />
                                <MenuItem Header="{x:Static resx:ResUI.menuRegionalPresets}">
                                    <MenuItem x:Name="menuRegionalPresetsDefault" Header="{x:Static resx:ResUI.menuRegionalPresetsDefault}" />
                                    <MenuItem x:Name="menuRegionalPresetsRussia" Header="{x:Static resx:ResUI.menuRegionalPresetsRussia}" />
                                    <MenuItem x:Name="menuRegionalPresetsIran" Header="{x:Static resx:ResUI.menuRegionalPresetsIran}" />
                                </MenuItem>
                                <MenuItem x:Name="menuBackupAndRestore" Header="{x:Static resx:ResUI.menuBackupAndRestore}" />
                                <MenuItem x:Name="menuOpenTheFileLocation" Header="{x:Static resx:ResUI.menuOpenTheFileLocation}" />
                                <MenuItem x:Name="menuClearServerStatistics" Header="{x:Static resx:ResUI.menuClearServerStatistics}" />
                                <MenuItem x:Name="menuSettingsSetUWP" Header="{x:Static resx:ResUI.TbSettingsSetUWP}" />
                                <Separator />
                                <MenuItem x:Name="menuRebootAsAdmin" Header="{x:Static resx:ResUI.menuRebootAsAdmin}" />
                                <MenuItem x:Name="menuReload" Header="{x:Static resx:ResUI.menuReload}" InputGestureText="F5" />
                                <MenuItem x:Name="menuHelp" Header="{x:Static resx:ResUI.menuHelp}">
                                    <MenuItem x:Name="menuCheckUpdate" Header="{x:Static resx:ResUI.menuCheckUpdate}" />
                                    <Separator />
                                </MenuItem>
                                <Separator />
                                <MenuItem x:Name="menuClose" Header="{x:Static resx:ResUI.menuClose}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <TextBlock Style="{StaticResource NavSection}" Text="{x:Static resx:AppText.NavSectionNetwork}" />
                    <RadioButton
                        x:Name="navServers"
                        IsChecked="True"
                        Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Server24" />
                            <TextBlock Text="{x:Static resx:AppText.NavServers}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navRules" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="BranchFork24" />
                            <TextBlock Text="{x:Static resx:AppText.NavRules}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navZapret" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="ShieldLock24" />
                            <TextBlock Text="{x:Static resx:AppText.NavZapret}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navTelegram" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Send24" />
                            <TextBlock Text="{x:Static resx:AppText.NavTelegram}" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Style="{StaticResource NavSection}" Text="{x:Static resx:AppText.NavSectionMonitor}" />
                    <RadioButton x:Name="navConnections" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="PlugConnected24" />
                            <TextBlock Text="{x:Static resx:AppText.NavConnections}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navGroups" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="Organization24" />
                            <TextBlock Text="{x:Static resx:AppText.NavGroups}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="navLog" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="TextBulletListLtr24" />
                            <TextBlock Text="{x:Static resx:AppText.NavLog}" />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Style="{StaticResource NavSection}" Text="{x:Static resx:AppText.NavSectionSystem}" />
                    <RadioButton x:Name="navHelp" Style="{StaticResource NavItem}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource NavIcon}" Symbol="BookQuestionMark24" />
                            <TextBlock Text="{x:Static resx:AppText.NavHelp}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>

            <!--  ============ Content ============  -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,1"
                    CornerRadius="6,0,0,6">
                    <Grid>
                        <!--  Servers  -->
                        <DockPanel x:Name="pageServers">
                            <Grid Margin="32,24,24,12" DockPanel.Dock="Top">
                                <ui:TextBlock
                                    VerticalAlignment="Center"
                                    FontTypography="Title"
                                    Text="{x:Static resx:AppText.NavServers}" />
                                <Menu HorizontalAlignment="Right" Background="Transparent">
                                    <MenuItem Header="{x:Static resx:AppText.ServersAdd}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Add24" />
                                        </MenuItem.Icon>
                                        <MenuItem
                                            x:Name="menuAddServerViaClipboard"
                                            Header="{x:Static resx:ResUI.menuAddServerViaClipboard}"
                                            InputGestureText="Ctrl+V" />
                                        <MenuItem
                                            x:Name="menuAddServerViaScan"
                                            Header="{x:Static resx:ResUI.menuAddServerViaScan}"
                                            InputGestureText="Ctrl+S" />
                                        <MenuItem x:Name="menuAddServerViaImage" Header="{x:Static resx:ResUI.menuAddServerViaImage}" />
                                        <MenuItem x:Name="menuAddServerViaFile" Header="{x:Static resx:AppText.ImportFromFile}" />
                                        <MenuItem x:Name="menuAddWarp" Header="{x:Static resx:AppText.WarpMenu}" ToolTip="{x:Static resx:AppText.WarpHint}" />
                                        <Separator />
                                        <MenuItem x:Name="menuAddVlessServer" Header="{x:Static resx:ResUI.menuAddVlessServer}" />
                                        <MenuItem x:Name="menuAddHysteria2Server" Header="{x:Static resx:ResUI.menuAddHysteria2Server}" />
                                        <MenuItem x:Name="menuAddTrojanServer" Header="{x:Static resx:ResUI.menuAddTrojanServer}" />
                                        <MenuItem x:Name="menuAddShadowsocksServer" Header="{x:Static resx:ResUI.menuAddShadowsocksServer}" />
                                        <MenuItem x:Name="menuAddWireguardServer" Header="{x:Static resx:ResUI.menuAddWireguardServer}" />
                                        <MenuItem x:Name="menuAddTuicServer" Header="{x:Static resx:ResUI.menuAddTuicServer}" />
                                        <MenuItem x:Name="menuAddVmessServer" Header="{x:Static resx:ResUI.menuAddVmessServer}" />
                                        <MenuItem Header="…">
                                            <MenuItem x:Name="menuAddAnytlsServer" Header="{x:Static resx:ResUI.menuAddAnytlsServer}" />
                                            <MenuItem x:Name="menuAddNaiveServer" Header="{x:Static resx:ResUI.menuAddNaiveServer}" />
                                            <MenuItem x:Name="menuAddMasqueServer" Header="{x:Static resx:ResUI.menuAddMasqueServer}" />
                                            <MenuItem x:Name="menuAddSocksServer" Header="{x:Static resx:ResUI.menuAddSocksServer}" />
                                            <MenuItem x:Name="menuAddHttpServer" Header="{x:Static resx:ResUI.menuAddHttpServer}" />
                                            <Separator />
                                            <MenuItem x:Name="menuAddCustomServer" Header="{x:Static resx:ResUI.menuAddCustomServer}" />
                                            <MenuItem x:Name="menuAddPolicyGroupServer" Header="{x:Static resx:ResUI.menuAddPolicyGroupServer}" />
                                            <MenuItem x:Name="menuAddProxyChainServer" Header="{x:Static resx:ResUI.menuAddProxyChainServer}" />
                                            <MenuItem x:Name="menuAddCustomOutboundServer" Header="{x:Static resx:ResUI.menuAddCustomOutboundServer}" />
                                        </MenuItem>
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resx:AppText.Groups}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="Folder24" />
                                        </MenuItem.Icon>
                                        <MenuItem x:Name="menuGroupNew" Header="{x:Static resx:AppText.GroupNew}" />
                                        <MenuItem x:Name="menuGroupRename" Header="{x:Static resx:AppText.GroupRename}" />
                                        <MenuItem x:Name="menuGroupDelete" Header="{x:Static resx:AppText.GroupDelete}" />
                                        <Separator />
                                        <MenuItem Header="{x:Static resx:AppText.GroupMoveHint}" IsEnabled="False" />
                                    </MenuItem>
                                    <MenuItem Header="{x:Static resx:AppText.ServersSubscriptions}">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Symbol="ArrowSync24" />
                                        </MenuItem.Icon>
                                        <MenuItem x:Name="menuSubUpdate" Header="{x:Static resx:ResUI.menuSubUpdate}" />
                                        <MenuItem x:Name="menuSubUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubUpdateViaProxy}" />
                                        <MenuItem x:Name="menuSubGroupUpdate" Header="{x:Static resx:ResUI.menuSubGroupUpdate}" />
                                        <MenuItem x:Name="menuSubGroupUpdateViaProxy" Header="{x:Static resx:ResUI.menuSubGroupUpdateViaProxy}" />
                                        <Separator />
                                        <MenuItem x:Name="menuSubSetting" Header="{x:Static resx:ResUI.menuSubSetting}" />
                                    </MenuItem>
                                </Menu>
                            </Grid>
                            <ContentControl
                                x:Name="connectionPanel"
                                Margin="32,0,24,12"
                                DockPanel.Dock="Top" />
                            <ContentControl x:Name="tabProfiles" Margin="20,0,12,8" />
                        </DockPanel>

                        <ContentControl x:Name="pageRules" Visibility="Collapsed" />
                        <ContentControl x:Name="pageZapret" Visibility="Collapsed" />
                        <ContentControl x:Name="pageTelegram" Visibility="Collapsed" />
                        <ContentControl x:Name="pageHelp" Visibility="Collapsed" />

                        <DockPanel x:Name="pageConnections" Visibility="Collapsed">
                            <ui:TextBlock
                                Margin="32,24,24,12"
                                DockPanel.Dock="Top"
                                FontTypography="Title"
                                Text="{x:Static resx:AppText.NavConnections}" />
                            <ContentControl x:Name="tabClashConnections" Margin="20,0,12,8" />
                        </DockPanel>

                        <DockPanel x:Name="pageGroups" Visibility="Collapsed">
                            <ui:TextBlock
                                Margin="32,24,24,12"
                                DockPanel.Dock="Top"
                                FontTypography="Title"
                                Text="{x:Static resx:AppText.NavGroups}" />
                            <ContentControl x:Name="tabClashProxies" Margin="20,0,12,8" />
                        </DockPanel>

                        <DockPanel x:Name="pageLog" Visibility="Collapsed">
                            <ui:TextBlock
                                Margin="32,24,24,12"
                                DockPanel.Dock="Top"
                                FontTypography="Title"
                                Text="{x:Static resx:AppText.NavLog}" />
                            <ContentControl x:Name="tabMsgView" Margin="20,0,12,8" />
                        </DockPanel>
                    </Grid>
                </Border>

                <ContentControl
                    x:Name="contentStatusBarView"
                    Grid.Row="1"
                    Margin="12,6,12,6" />

                <materialDesign:Snackbar
                    x:Name="MainSnackbar"
                    Grid.Row="0"
                    MessageQueue="{materialDesign:MessageQueue}" />
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</base:WindowBase>
