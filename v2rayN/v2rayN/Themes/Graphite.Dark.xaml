<!--
    Detour "graphite" palette, dark. Overrides WPF-UI theme brushes (merged after its
    ThemesDictionary) and defines the app's own Detour* tokens. Swapped in by ThemeSettingViewModel.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Own tokens  -->
    <Color x:Key="DetourAccentColor">#4F8CFF</Color>
    <SolidColorBrush x:Key="DetourAccentBrush" Color="#4F8CFF" />
    <SolidColorBrush x:Key="DetourAccentSoftBrush" Color="#264F8CFF" />
    <SolidColorBrush x:Key="DetourOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DetourWarnBrush" Color="#E0A040" />
    <SolidColorBrush x:Key="DetourErrorBrush" Color="#F0524F" />
    <SolidColorBrush x:Key="DetourIdleBrush" Color="#5C6470" />
    <SolidColorBrush x:Key="DetourPanelBrush" Color="#14171C" />
    <SolidColorBrush x:Key="DetourPanelHeaderBrush" Color="#181C22" />
    <SolidColorBrush x:Key="DetourLineBrush" Color="#262B33" />
    <SolidColorBrush x:Key="DetourGridBrush" Color="#1C2027" />
    <SolidColorBrush x:Key="DetourLabelBrush" Color="#6E7783" />
    <SolidColorBrush x:Key="DetourSidebarBrush" Color="#0B0D10" />

    <!--  WPF-UI overrides  -->
