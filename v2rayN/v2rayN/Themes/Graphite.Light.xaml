<!--  Detour "graphite" palette, light. Same keys as Graphite.Dark.xaml.  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Own tokens  -->
    <Color x:Key="DetourAccentColor">#2F6FE8</Color>
    <SolidColorBrush x:Key="DetourAccentBrush" Color="#2F6FE8" />
    <SolidColorBrush x:Key="DetourAccentSoftBrush" Color="#1A2F6FE8" />
    <SolidColorBrush x:Key="DetourOnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DetourWarnBrush" Color="#B7791F" />
    <SolidColorBrush x:Key="DetourErrorBrush" Color="#D93B38" />
    <SolidColorBrush x:Key="DetourIdleBrush" Color="#9AA2AD" />
    <SolidColorBrush x:Key="DetourPanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DetourPanelHeaderBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="DetourLineBrush" Color="#DDE1E6" />
    <SolidColorBrush x:Key="DetourGridBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="DetourLabelBrush" Color="#7A838F" />
    <SolidColorBrush x:Key="DetourSidebarBrush" Color="#ECEEF1" />

    <!--  WPF-UI overrides  -->
    <Color x:Key="ApplicationBackgroundColor">#ECEEF1</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#ECEEF1" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#F6F7F9" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DDE1E6" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#DDE1E6" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#E3E6EA" />

    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#E2E5E9" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#E8EAED" />

    <!--  MaterialDesign (older dialogs)  -->
    <SolidColorBrush x:Key="MaterialDesignPaper" Color="#F7F8FA" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="#F7F8FA" />
    <SolidColorBrush x:Key="MaterialDesignBody" Color="#14171C" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Foreground" Color="#14171C" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.ForegroundLight" Color="#4B5563" />
    <SolidColorBrush x:Key="MaterialDesignCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Card.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MaterialDesignDivider" Color="#DDE1E6" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Separator.Background" Color="#DDE1E6" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.TextBox.HoverBorder" Color="#2F6FE8" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.ComboBox.HoverBorder" Color="#2F6FE8" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary" Color="#2F6FE8" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light" Color="#DCE7FC" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Light.Foreground" Color="#1C3F8A" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark" Color="#2459C4" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Primary.Dark.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary" Color="#2F6FE8" />
    <SolidColorBrush x:Key="MaterialDesign.Brush.Secondary.Foreground" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#14171C" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#7A838F" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#A6ADB6" />
</ResourceDictionary>
