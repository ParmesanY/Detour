<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
		<UseWPF>true</UseWPF>
		<AssemblyName>Detour</AssemblyName>
		<RootNamespace>v2rayN</RootNamespace>
		<Product>Detour</Product>
		<AssemblyTitle>Detour</AssemblyTitle>
		<Company>Detour</Company>
		<Description>Detour: VPN client with built-in zapret. Based on v2rayN by 2dust (GPL-3.0).</Description>
		<Copyright>Detour, based on v2rayN (c) 2017-2026 2dust, GPL-3.0</Copyright>
		<ApplicationIcon>Resources\app.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CETCompat>false</CETCompat>
		<!-- Detour's own version (the assembly Version stays upstream's: subscriptions key on it).
		     CI sets both from the tag / repository: -p:DetourVersion=1.2.0 -p:DetourRepo=owner/name -->
		<DetourVersion Condition="'$(DetourVersion)' == ''">0.3.5</DetourVersion>
		<DetourRepo Condition="'$(DetourRepo)' == ''"></DetourRepo>
		<!-- Compressed single file: Detour.exe 180 → 76 MB on disk (the release zip stays about the same). -->
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyMetadata Include="DetourVersion" Value="$(DetourVersion)" />
		<AssemblyMetadata Include="DetourRepo" Value="$(DetourRepo)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MaterialDesignThemes" />
		<PackageReference Include="WPF-UI" />
		<PackageReference Include="H.NotifyIcon.Wpf" />
		<PackageReference Include="ReactiveUI.WPF" />
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="app.manifest" />
		<EmbeddedResource Include="Resources\app.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<Resource Include="Resources\NotifyIcon1.ico" />
		<Resource Include="Resources\NotifyIcon2.ico" />
		<Resource Include="Resources\NotifyIcon3.ico" />
		<Resource Include="Resources\NotifyIcon4.ico" />
		<Resource Include="Resources\app.ico" />
		<Resource Include="Resources\logo.png" />
		<!-- Twemoji flags (CC-BY 4.0), see Resources\Flags\LICENSE.txt -->
		<Resource Include="Resources\Flags\*.png" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ServiceLib\ServiceLib.csproj" />
	</ItemGroup>

	<!-- The single-file publish leaves out msquic.dll, and without it the Detour Map probe reports QUIC as
	     "unsupported". Take it from the runtime pack, next to Detour.exe like the other native libraries. -->
	<Target Name="CopyMsQuic" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('win'))">
		<ItemGroup>
			<_MsQuic Include="@(ResolvedRuntimePack->'%(PackageDirectory)\runtimes\$(RuntimeIdentifier)\native\msquic.dll')" />
		</ItemGroup>
		<Copy SourceFiles="@(_MsQuic)" DestinationFolder="$(PublishDir)" Condition="Exists('%(_MsQuic.FullPath)')" SkipUnchangedFiles="true" />
	</Target>

</Project>
